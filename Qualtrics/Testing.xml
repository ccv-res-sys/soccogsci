   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;BL-Y-Des&gt;I wanted to save Jessie's life&lt;/BL-Y-Des&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;BL-Y-Bel&gt;I knew I could save Jessie's life&lt;/BL-Y-Des&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-Y-Deo&gt;Saving a life is the moral action to take&lt;/BL-Y-Deo&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-Y-Uti&gt;This way, Jessie's life would be saved&lt;/BL-Y-Uti&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-N-Des&gt;I wanted the other person's consent for the transfusion&lt;/BL-N-Des&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-N-Bel&gt;I knew that the other person had not given consent&lt;/BL-N-Bel&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-N-Deo&gt;It is morally wrong to violate a person's autonomy&lt;/BL-N-Deo&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-N-Uti&gt;This way, the other patient would not be subjected to a transfusion without their consent.&lt;/BL-N-Uti&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s63"><Data ss:Type="String">&lt;BL-Mere-long&gt;The ethics review could not be completed in time, so I had to make a decision&lt;/BL-Mere-long&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-Y-Des&gt;I wanted to save more lives&lt;/AI-Y-Des&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-Y-Bel&gt;I knew fewer lives would be lost&lt;/AI-Y-Bel&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-Y-Deo&gt;It is morally required to save as many lives as possible&lt;/AI-Y-Deo&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-Y-Uti&gt;More lives would be saved&lt;/AI-Y-Uti&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-N-Des&gt;I wanted to protect the child's life&lt;/AI-N-Des&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-N-Bel&gt;I knew the child could die&lt;/AI-N-Bel&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-N-Deo&gt;It is morally wrong to violate a person's autonomy&lt;/AI-N-Deo&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-N-Uti&gt;The consequences of killing the child would be disastrous&lt;/AI-N-Uti&gt;</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s62"><Data ss:Type="String">&lt;AI-Mere&gt;The commanders approved either course of action, so I had to make a decision&lt;/AI-Mere&gt;</Data></Cell>
   </Row>
